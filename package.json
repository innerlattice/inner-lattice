{
  "name": "inner-lattice",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "npm run build && node --test test/metadata.test.mjs",
    "preview": "astro preview",
    "check:commas": "uv run --project tools/prose-lint prose-lint --rule serial-comma src/content/posts/*.md",
    "lint:prose": "uv run --project tools/prose-lint prose-lint"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.7",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^11.17.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex",
    "dompurify": "3.4.16",
    "http-cache-semantics": "4.3.0"
  }
}
