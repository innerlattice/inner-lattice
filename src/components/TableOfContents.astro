---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const entries = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{entries.length > 0 && (
  <nav class="toc" id="page-contents" popover aria-labelledby="toc-label">
    <p class="toc-label" id="toc-label">contents</p>
    <ol class="toc-list">
      {entries.map((heading) => (
        <li class={`toc-item toc-depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  const toc = document.querySelector<HTMLElement>('.toc');
  const list = toc?.querySelector<HTMLElement>('.toc-list');

  if (toc && list) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a'));
    const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    let active = -2;
    let pending = false;

    // The list follows the reader, but never while the reader is using it: not
    // under the pointer, not while it has focus, and not for a moment after the
    // reader scrolls it by hand. It catches up at the next section change.
    let pointerInside = false;
    let handledAt = 0;
    const HANDS_OFF_MS = 1500;
    const inUse = () =>
      // Keyboard focus only: a clicked link keeps focus, and should not freeze the list.
      pointerInside || toc.querySelector(':focus-visible') !== null || Date.now() - handledAt < HANDS_OFF_MS;

    toc.addEventListener('pointerenter', () => (pointerInside = true));
    toc.addEventListener('pointerleave', () => (pointerInside = false));
    for (const type of ['wheel', 'touchstart', 'touchmove']) {
      list.addEventListener(type, () => (handledAt = Date.now()), { passive: true });
    }

    // The current section is the last heading above a line a quarter of the way
    // down the viewport. At the very bottom of the page, the last heading wins.
    const currentIndex = () => {
      const line = window.innerHeight * 0.25;
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let index = -1;

      sections.forEach((section, i) => {
        if (!section) return;
        const top = section.getBoundingClientRect().top;
        if (top <= line || (atBottom && top < window.innerHeight)) index = i;
      });

      return index;
    };

    // Only the list scrolls, never the page. Short moves glide; long ones, as
    // after a jump across the essay, happen at once.
    const centre = (item: HTMLElement | undefined, first: boolean) => {
      if (list.scrollHeight <= list.clientHeight) return;
      const top = item ? item.offsetTop - list.clientHeight / 2 + item.offsetHeight / 2 : 0;
      const distance = Math.abs(top - list.scrollTop);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const smooth = !first && !reduce && distance < list.clientHeight;
      list.scrollTo({ top, behavior: smooth ? 'smooth' : 'auto' });
    };

    const update = () => {
      pending = false;
      const index = currentIndex();
      if (index === active) return;

      const first = active === -2;
      active = index;
      links.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (first || !inUse()) centre(links[index]?.parentElement ?? undefined, first);
    };

    const schedule = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(update);
    };

    // The fade at the bottom of the inset box only shows when there is more to scroll to.
    const markScrollable = () =>
      list.classList.toggle('is-scrollable', list.scrollHeight > list.clientHeight + 1);

    // On a phone the list opens from the header as a popover. It opens at the
    // current section, and choosing a section closes it.
    toc.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState !== 'open') return;
      markScrollable();
      centre(links[active]?.parentElement ?? undefined, true);
    });
    toc.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest('a');
      if (link && 'hidePopover' in toc && toc.matches(':popover-open')) toc.hidePopover();
    });

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => {
      markScrollable();
      schedule();
    });
    markScrollable();
    update();
  }
</script>
