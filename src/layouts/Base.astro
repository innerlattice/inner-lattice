---
import '../styles/global.css';
import { authorName, siteDescription, siteTagline, siteTitle } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Leave out the site header and footer, as on the not-found page. */
  bare?: boolean;
}

const {
  title,
  description = siteDescription,
  type = 'website',
  publishedTime,
  modifiedTime,
  bare = false,
} = Astro.props;
const fullTitle = title === siteTitle ? `${siteTitle} | ${siteTagline}` : `${title} | ${siteTitle}`;
// Pages build to /slug/index.html but are canonical without the trailing slash.
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site ?? Astro.url);
const socialImage = new URL('/social/inner-lattice.jpg', pageUrl);
const socialImageX = new URL('/social/inner-lattice-x.jpg', pageUrl);
const supportUrl = 'https://ko-fi.com/innerlattice?utm_source=innerlattice&utm_medium=footer';
const structuredData = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: pageUrl.href,
  mainEntityOfPage: pageUrl.href,
  image: socialImage.href,
  datePublished: publishedTime?.toISOString(),
  dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
  author: { '@type': 'Person', name: authorName },
  publisher: { '@type': 'Organization', name: siteTitle, url: new URL('/', pageUrl).href },
} : {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteTitle,
  url: new URL('/', pageUrl).href,
};
const socialImageAlt ='A light, open glass lattice catching pearlescent pink, lavender and cyan light on an off-white background.';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16181b" />
    <meta name="description" content={description} />
    {type === 'article' && <meta name="author" content={authorName} />}
    <script is:inline>
      // Apply a saved theme before the first paint, so the page never flashes.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL('/rss.xml', pageUrl)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageX} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />
  </head>
  <body>
    <div class:list={['container', { 'container-bare': bare }]}>
      {!bare && (
        <header class="site-header">
          <a href="/" class="site-title">inner latti<span class="ce-c">c</span>e</a>
          <div class="theme-toggle" role="radiogroup" aria-label="Colour theme" hidden>
            <button type="button" role="radio" aria-checked="false" data-theme-choice="light" aria-label="Light" title="Light">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
            </button>
            <button type="button" role="radio" aria-checked="false" data-theme-choice="system" aria-label="Match system" title="Match system">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" class="fill" /></svg>
            </button>
            <button type="button" role="radio" aria-checked="false" data-theme-choice="dark" aria-label="Dark" title="Dark">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" /></svg>
            </button>
          </div>
        </header>
      )}
      <main>
        <slot />
      </main>
      {!bare && (
        <footer class="site-footer">
          <p class="support">
            {type === 'article' ? (
              <>did you get value from this essay? please <a href={supportUrl}>help fund the next one</a>.</>
            ) : (
              <>if you enjoy these essays, please <a href={supportUrl}>help fund more</a>.</>
            )}
            a message with your donation might inspire a new essay too!
          </p>
          <div class="footer-meta">
            <a href="/rss.xml">rss</a>
            <span class="copyright">&copy; {new Date().getFullYear()}</span>
          </div>
        </footer>
      )}
    </div>

    <script>
      import mermaid from 'mermaid';

      const prepareResponsiveTables = () => {
        for (const table of document.querySelectorAll<HTMLTableElement>('.post-content table')) {
          const headers = Array.from(table.tHead?.rows[0]?.cells ?? [], (cell) => {
            const label = cell.cloneNode(true) as HTMLElement;
            // KaTeX includes hidden MathML alongside the visible label.
            label.querySelectorAll('.katex-mathml').forEach((math) => math.remove());
            return label.textContent?.trim() ?? '';
          });

          // Short tables remain easier to scan in their native tabular layout.
          if (headers.length < 3) continue;

          table.classList.add('mobile-card-table');

          for (const row of table.tBodies[0]?.rows ?? []) {
            Array.from(row.cells).forEach((cell, index) => {
              cell.dataset.label = headers[index] ?? '';
            });
          }
        }
      };

      const getDiagramDimensions = (svg: SVGSVGElement) => {
        const viewBox = svg.viewBox.baseVal;
        const bounds = svg.getBoundingClientRect();
        const width = viewBox.width || svg.width.baseVal.value || bounds.width;
        const height = viewBox.height || svg.height.baseVal.value || bounds.height;

        if (!width || !height) {
          throw new Error('The diagram has no exportable dimensions.');
        }

        return { width, height };
      };

      const loadImage = (source: string) =>
        new Promise<HTMLImageElement>((resolve, reject) => {
          const image = new Image();
          image.onload = () => resolve(image);
          image.onerror = () => reject(new Error('The diagram could not be prepared for export.'));
          image.src = source;
        });

      const renderDiagramPng = async (svg: SVGSVGElement, backgroundColor: string) => {
        const { width, height } = getDiagramDimensions(svg);
        const scale = Math.min(2, 8192 / width, 8192 / height);
        const canvas = document.createElement('canvas');
        canvas.width = Math.ceil(width * scale);
        canvas.height = Math.ceil(height * scale);

        const context = canvas.getContext('2d');
        if (!context) throw new Error('PNG export is not supported by this browser.');

        context.scale(scale, scale);
        context.fillStyle = backgroundColor;
        context.fillRect(0, 0, width, height);

        const exportedSvg = svg.cloneNode(true) as SVGSVGElement;
        exportedSvg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
        exportedSvg.setAttribute('width', String(width));
        exportedSvg.setAttribute('height', String(height));
        exportedSvg.style.maxWidth = 'none';

        const svgBlob = new Blob([new XMLSerializer().serializeToString(exportedSvg)], {
          type: 'image/svg+xml;charset=utf-8',
        });
        const svgUrl = URL.createObjectURL(svgBlob);

        try {
          const image = await loadImage(svgUrl);
          context.drawImage(image, 0, 0, width, height);
        } finally {
          URL.revokeObjectURL(svgUrl);
        }

        return new Promise<Blob>((resolve, reject) => {
          canvas.toBlob((blob) => {
            if (blob) resolve(blob);
            else reject(new Error('The diagram could not be encoded as a PNG.'));
          }, 'image/png');
        });
      };

      const addDiagramDownloadButtons = () => {
        const pageName =
          window.location.pathname.split('/').filter(Boolean).at(-1) ?? 'inner-lattice';

        document.querySelectorAll<HTMLElement>('.mermaid-container').forEach((container, index) => {
          if (container.querySelector('.mermaid-download')) return;

          const svg = container.querySelector<SVGSVGElement>('.mermaid svg');
          if (!svg) return;

          const button = document.createElement('button');
          const diagramNumber = index + 1;
          button.type = 'button';
          button.className = 'mermaid-download';
          button.disabled = true;
          button.setAttribute('aria-label', `Download diagram ${diagramNumber} as PNG`);
          button.title = 'Preparing PNG';
          button.innerHTML = `
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" />
            </svg>
          `;

          const backgroundColor = getComputedStyle(container).backgroundColor;
          renderDiagramPng(svg, backgroundColor)
            .then((png) => {
              button.addEventListener('click', () => {
                const pngUrl = URL.createObjectURL(png);
                const link = document.createElement('a');
                link.href = pngUrl;
                link.download = `${pageName}-diagram-${diagramNumber}.png`;
                document.body.append(link);
                link.click();
                link.remove();
                window.setTimeout(() => URL.revokeObjectURL(pngUrl), 1000);
              });

              button.disabled = false;
              button.title = 'Download as PNG';
            })
            .catch((error) => {
              button.title = 'PNG download unavailable';
              console.error('Could not download Mermaid diagram.', error);
            });

          container.append(button);
        });
      };

      // Tokens are light-dark() pairs, so a token is resolved by applying it to
      // an element and reading the colour the browser computes.
      const token = (() => {
        let probe: HTMLElement | undefined;
        return (name: string) => {
          if (!probe) {
            probe = document.createElement('span');
            probe.hidden = true;
            document.body.append(probe);
          }
          probe.style.color = `var(${name})`;
          return getComputedStyle(probe).color;
        };
      })();

      // Mermaid takes literal colours, so they are read from the design tokens
      // each time the diagrams are drawn.
      const mermaidTheme = () => ({
        background: token('--color-surface-raised'),
        mainBkg: token('--mermaid-node'),
        secondBkg: token('--color-surface'),
        primaryColor: token('--mermaid-node'),
        primaryTextColor: token('--color-text'),
        primaryBorderColor: token('--mermaid-node-border'),
        secondaryColor: token('--mermaid-cluster'),
        secondaryTextColor: token('--color-text'),
        secondaryBorderColor: token('--mermaid-cluster-border'),
        tertiaryColor: token('--mermaid-tertiary'),
        tertiaryTextColor: token('--color-text'),
        tertiaryBorderColor: token('--mermaid-cluster-border'),
        lineColor: token('--color-accent'),
        textColor: token('--color-text'),
        noteBkgColor: token('--mermaid-note'),
        noteTextColor: token('--color-text'),
        noteBorderColor: token('--mermaid-note-border'),
        actorBkg: token('--mermaid-node'),
        actorTextColor: token('--color-text'),
        actorBorder: token('--mermaid-node-border'),
        signalColor: token('--color-link'),
        signalTextColor: token('--color-text'),
      });

      const drawMermaidDiagrams = async () => {
        const diagrams = document.querySelectorAll<HTMLElement>('.mermaid[data-source]');
        if (diagrams.length === 0) return;

        for (const diagram of diagrams) {
          diagram.removeAttribute('data-processed');
          diagram.textContent = diagram.dataset.source ?? '';
          diagram.parentElement?.querySelector('.mermaid-download')?.remove();
        }

        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'loose',
          htmlLabels: false,
          theme: 'base',
          themeVariables: mermaidTheme(),
        });

        await mermaid.run({ nodes: diagrams });
        addDiagramDownloadButtons();
      };

      const renderMermaidDiagrams = async () => {
        for (const pre of document.querySelectorAll('pre[data-language="mermaid"]')) {
          const text = pre.textContent?.trim() ?? '';
          if (!text) continue;

          const container = document.createElement('div');
          container.className = 'mermaid-container';
          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid';
          wrapper.dataset.source = text;
          container.append(wrapper);
          pre.replaceWith(container);
        }

        await drawMermaidDiagrams();
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', drawMermaidDiagrams);
        document.addEventListener('themechange', drawMermaidDiagrams);
      };

      // The toggle pins light or dark on <html>, or clears it to follow the system.
      const setUpThemeToggle = () => {
        const toggle = document.querySelector<HTMLElement>('.theme-toggle');
        if (!toggle) return;
        const buttons = Array.from(toggle.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));
        const themeColors = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
        const original = Array.from(themeColors, (meta) => meta.content);

        const show = (choice: string) => {
          for (const button of buttons) {
            const checked = button.dataset.themeChoice === choice;
            button.setAttribute('aria-checked', String(checked));
            button.tabIndex = checked ? 0 : -1;
          }
          // The browser chrome follows a pinned theme too.
          themeColors.forEach((meta, i) => {
            meta.content = choice === 'system' ? original[i] : token('--color-bg');
          });
        };

        const choose = (choice: string) => {
          if (choice === 'system') delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = choice;
          try {
            if (choice === 'system') localStorage.removeItem('theme');
            else localStorage.setItem('theme', choice);
          } catch {}
          show(choice);
          document.dispatchEvent(new Event('themechange'));
        };

        toggle.addEventListener('click', (event) => {
          const button = (event.target as Element).closest<HTMLButtonElement>('[data-theme-choice]');
          if (button?.dataset.themeChoice) choose(button.dataset.themeChoice);
        });

        // Arrow keys move between choices, as in any radio group.
        toggle.addEventListener('keydown', (event) => {
          const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
          if (!step) return;
          event.preventDefault();
          const current = buttons.findIndex((button) => button.getAttribute('aria-checked') === 'true');
          const next = buttons[(current + step + buttons.length) % buttons.length];
          next.focus();
          if (next.dataset.themeChoice) choose(next.dataset.themeChoice);
        });

        show(document.documentElement.dataset.theme ?? 'system');
        toggle.hidden = false;
      };

      setUpThemeToggle();

      // A section link copies the canonical URL of its section, so a link copied
      // from a local preview still points at the published essay.
      const copySectionLinks = () => {
        let toast: HTMLElement | undefined;
        let hideToast: number | undefined;

        const announce = (message: string) => {
          if (!toast) {
            toast = document.createElement('div');
            toast.className = 'heading-link-toast';
            toast.setAttribute('role', 'status');
            document.body.append(toast);
          }
          toast.textContent = message;
          toast.setAttribute('data-visible', '');
          window.clearTimeout(hideToast);
          hideToast = window.setTimeout(() => toast?.removeAttribute('data-visible'), 1600);
        };

        document.addEventListener('click', async (event) => {
          const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('.heading-link');
          if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          event.preventDefault();
          const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href;
          const url = new URL(link.hash, canonical ?? window.location.href).href;
          history.replaceState(null, '', link.hash);

          try {
            await navigator.clipboard.writeText(url);
            link.setAttribute('data-copied', '');
            window.setTimeout(() => link.removeAttribute('data-copied'), 1600);
            announce('link copied');
          } catch {
            announce('could not copy the link');
          }
        });
      };

      copySectionLinks();
      prepareResponsiveTables();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
      } else {
        renderMermaidDiagrams();
      }
    </script>
  </body>
</html>
