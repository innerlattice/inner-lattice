---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Explorations in consciousness and cosmology',
  type = 'website',
} = Astro.props;
const siteTitle = 'inner lattice';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = new URL('/social/inner-lattice.jpg', pageUrl);
const socialImageX = new URL('/social/inner-lattice-x.jpg', pageUrl);
const socialImageAlt = 'A light, open glass lattice catching pearlescent pink, lavender and cyan light on an off-white background.';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageX} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="site-title">inner latti<span class="ce-c">c</span>e</a>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>&copy; {new Date().getFullYear()}</p>
      </footer>
    </div>

    <script>
      import mermaid from 'mermaid';

      const prepareResponsiveTables = () => {
        for (const table of document.querySelectorAll<HTMLTableElement>('.post-content table')) {
          const headers = Array.from(table.tHead?.rows[0]?.cells ?? [], (cell) => {
            const label = cell.cloneNode(true) as HTMLElement;
            // KaTeX includes hidden MathML alongside the visible label.
            label.querySelectorAll('.katex-mathml').forEach((math) => math.remove());
            return label.textContent?.trim() ?? '';
          });

          // Short tables remain easier to scan in their native tabular layout.
          if (headers.length < 3) continue;

          table.classList.add('mobile-card-table');

          for (const row of table.tBodies[0]?.rows ?? []) {
            Array.from(row.cells).forEach((cell, index) => {
              cell.dataset.label = headers[index] ?? '';
              // Keep mixed text, emphasis and math together in one grid cell.
              if (!cell.querySelector(':scope > .table-cell-content')) {
                const content = document.createElement('div');
                content.className = 'table-cell-content';
                content.append(...cell.childNodes);
                cell.append(content);
              }
            });
          }
        }
      };

      const getDiagramDimensions = (svg: SVGSVGElement) => {
        const viewBox = svg.viewBox.baseVal;
        const bounds = svg.getBoundingClientRect();
        const width = viewBox.width || svg.width.baseVal.value || bounds.width;
        const height = viewBox.height || svg.height.baseVal.value || bounds.height;

        if (!width || !height) {
          throw new Error('The diagram has no exportable dimensions.');
        }

        return { width, height };
      };

      const loadImage = (source: string) =>
        new Promise<HTMLImageElement>((resolve, reject) => {
          const image = new Image();
          image.onload = () => resolve(image);
          image.onerror = () => reject(new Error('The diagram could not be prepared for export.'));
          image.src = source;
        });

      const renderDiagramPng = async (svg: SVGSVGElement, backgroundColor: string) => {
        const { width, height } = getDiagramDimensions(svg);
        const scale = Math.min(2, 8192 / width, 8192 / height);
        const canvas = document.createElement('canvas');
        canvas.width = Math.ceil(width * scale);
        canvas.height = Math.ceil(height * scale);

        const context = canvas.getContext('2d');
        if (!context) throw new Error('PNG export is not supported by this browser.');

        context.scale(scale, scale);
        context.fillStyle = backgroundColor;
        context.fillRect(0, 0, width, height);

        const exportedSvg = svg.cloneNode(true) as SVGSVGElement;
        exportedSvg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
        exportedSvg.setAttribute('width', String(width));
        exportedSvg.setAttribute('height', String(height));
        exportedSvg.style.maxWidth = 'none';

        const svgBlob = new Blob([new XMLSerializer().serializeToString(exportedSvg)], {
          type: 'image/svg+xml;charset=utf-8',
        });
        const svgUrl = URL.createObjectURL(svgBlob);

        try {
          const image = await loadImage(svgUrl);
          context.drawImage(image, 0, 0, width, height);
        } finally {
          URL.revokeObjectURL(svgUrl);
        }

        return new Promise<Blob>((resolve, reject) => {
          canvas.toBlob((blob) => {
            if (blob) resolve(blob);
            else reject(new Error('The diagram could not be encoded as a PNG.'));
          }, 'image/png');
        });
      };

      const addDiagramDownloadButtons = () => {
        const pageName =
          window.location.pathname.split('/').filter(Boolean).at(-1) ?? 'inner-lattice';

        document.querySelectorAll<HTMLElement>('.mermaid-container').forEach((container, index) => {
          if (container.querySelector('.mermaid-download')) return;

          const svg = container.querySelector<SVGSVGElement>('.mermaid svg');
          if (!svg) return;

          const button = document.createElement('button');
          const diagramNumber = index + 1;
          button.type = 'button';
          button.className = 'mermaid-download';
          button.disabled = true;
          button.setAttribute('aria-label', `Download diagram ${diagramNumber} as PNG`);
          button.title = 'Preparing PNG';
          button.innerHTML = `
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" />
            </svg>
          `;

          const backgroundColor = getComputedStyle(container).backgroundColor;
          renderDiagramPng(svg, backgroundColor)
            .then((png) => {
              button.addEventListener('click', () => {
                const pngUrl = URL.createObjectURL(png);
                const link = document.createElement('a');
                link.href = pngUrl;
                link.download = `${pageName}-diagram-${diagramNumber}.png`;
                document.body.append(link);
                link.click();
                link.remove();
                window.setTimeout(() => URL.revokeObjectURL(pngUrl), 1000);
              });

              button.disabled = false;
              button.title = 'Download as PNG';
            })
            .catch((error) => {
              button.title = 'PNG download unavailable';
              console.error('Could not download Mermaid diagram.', error);
            });

          container.append(button);
        });
      };

      const renderMermaidDiagrams = async () => {
        for (const pre of document.querySelectorAll('pre[data-language="mermaid"]')) {
          const text = pre.textContent?.trim() ?? '';
          if (!text) continue;

          const container = document.createElement('div');
          container.className = 'mermaid-container';
          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid';
          wrapper.textContent = text;
          container.append(wrapper);
          pre.replaceWith(container);
        }

        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'loose',
          htmlLabels: false,
          theme: 'base',
          themeVariables: {
            background: '#edf2f4',
            mainBkg: '#fafafa',
            secondBkg: '#f1f4f6',
            primaryColor: '#fafafa',
            primaryTextColor: '#2d2d2d',
            primaryBorderColor: '#aeb8c0',
            secondaryColor: '#edf2f4',
            secondaryTextColor: '#2d2d2d',
            secondaryBorderColor: '#c8d1d8',
            tertiaryColor: '#e8ecef',
            tertiaryTextColor: '#2d2d2d',
            tertiaryBorderColor: '#c8d1d8',
            lineColor: '#5a6b7c',
            textColor: '#2d2d2d',
            noteBkgColor: '#f7f8f4',
            noteTextColor: '#2d2d2d',
            noteBorderColor: '#d8d4bd',
            actorBkg: '#fafafa',
            actorTextColor: '#2d2d2d',
            actorBorder: '#aeb8c0',
            signalColor: '#4a5a6a',
            signalTextColor: '#2d2d2d',
          },
        });

        await mermaid.run();
        addDiagramDownloadButtons();
      };

      prepareResponsiveTables();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
      } else {
        renderMermaidDiagrams();
      }
    </script>
  </body>
</html>
