---
import { getCollection, render } from 'astro:content';
import SeriesNav from '../components/SeriesNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/dates';
import { getArticleDescription } from '../lib/descriptions.mjs';
import { getSeriesForPost } from '../lib/series';
import { getTagSlug } from '../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const description = getArticleDescription(post.data.description, post.body);
const seriesContext = await getSeriesForPost(post.id);
// Long essays get a table of contents: enough words to lose your place in,
// and enough sections to make a map worth reading.
const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const showContents = wordCount >= 2000 && headings.filter((heading) => heading.depth === 2).length >= 4;
---

<Base title={post.data.title} description={description} type="article" publishedTime={post.data.date}
  modifiedTime={post.data.updated} contents={showContents}
>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      {seriesContext && (
        <p class="post-series">
          part {seriesContext.part.number} of the{" "}
          <a href={`/series/${seriesContext.series.id}`}>{seriesContext.series.name}</a> series
        </p>
      )}
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>{" "}
        <span class="tags">
          {post.data.tags.map((tag) => (
            <><a class="tag" href={`/tags/${getTagSlug(tag)}`}>{tag}</a>{" "}</>
          ))}
        </span>
      </div>
    </header>
    {showContents && <TableOfContents headings={headings} />}
    <div class="post-content">
      <Content />
    </div>
    {seriesContext && <SeriesNav context={seriesContext} />}
    <footer class="post-footer">
      <a href="/">&larr; back to all posts</a>
      {seriesContext?.next?.post && (
        <a class="series-next" href={`/${seriesContext.next.post.id}`}>
          next: {seriesContext.next.title} <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </footer>
  </article>
</Base>
